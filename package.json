{
  "name": "football-tactics-board-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "node scripts/prepare-xg.mjs && vp dev --host 0.0.0.0",
    "build": "node scripts/prepare-xg.mjs && tsc --noEmit && vp build",
    "preview": "vp preview --host 0.0.0.0",
    "test": "node scripts/prepare-xg.mjs && vp test run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "vp fmt",
    "docs:screenshots": "node scripts/capture-readme.mjs",
    "models:prepare": "node scripts/prepare-xg.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "packageManager": "pnpm@12.16.1"
}
